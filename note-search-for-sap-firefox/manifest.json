{
  "manifest_version": 3,
  "name": "Note Search for SAP",
  "version": "1.3.2",
  "description": "Quickly open SAP Notes by number and jump to SAP for Me, Launchpad, and other support services.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Note Search for SAP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["tabs", "contextMenus", "notifications", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Open Note Search for SAP popup"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "note-search-for-sap@local.dev",
      "strict_min_version": "115.0"
    }
  }
}
